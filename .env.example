# Chave da Google Routes API (obrigatória)
# Obtenha em: https://console.cloud.google.com/ -> APIs e Serviços -> Credenciais
# Habilite a "Routes API" no projeto antes de usar.
GOOGLE_ROUTES_API_KEY=sua-chave-aqui

# URL base que o frontend usará para falar com o backend
VITE_API_BASE_URL=http://localhost:8081

# Origens permitidas no CORS do backend (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
